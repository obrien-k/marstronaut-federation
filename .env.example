# Copy to .env and fill in your values.

# NASA Open APIs key — get one free at https://api.nasa.gov/
# Leave unset (or use the built-in DEMO_KEY) for 30 req/hour during local dev.
NASA_KEY=DEMO_KEY

# Override the gateway listen port (defaults to 4000)
# PORT=4000

# Override individual subgraph URLs (defaults to localhost)
# ACCOUNTS_SUBGRAPH_URL=http://localhost:4003
# NASA_SUBGRAPH_URL=http://localhost:4001
# XKCD_SUBGRAPH_URL=http://localhost:4002
